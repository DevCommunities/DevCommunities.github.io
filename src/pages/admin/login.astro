---
import "../../components/admin/admin.css";
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><title>เข้าสู่ระบบ | DevCommu</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="admin-login-shell">
      <a class="admin-brand" href="/@devcommu/"><img src="/favicon.svg" width="30" height="30" alt="" />DevCommu</a>
      <div class="admin-login-card">
        <h1>เข้าสู่ระบบ</h1><p class="admin-help">จัดการค่าย กิจกรรม และเนื้อหาบนเว็บไซต์</p>
        <form id="password-login" class="admin-auth-form" method="post" action="/api/admin/login">
          <label>ชื่อผู้ใช้<input name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="48" /></label>
          <label>รหัสผ่าน<input id="login-password" name="password" type="password" autocomplete="current-password" required maxlength="128" /></label>
          <label class="admin-checkbox"><input id="show-password" type="checkbox" />แสดงรหัสผ่าน</label>
          <p id="login-error" class="admin-error" role="alert" hidden></p>
          <button type="submit" class="admin-primary">เข้าสู่ระบบ</button>
          <p id="login-status" class="admin-help" role="status" aria-live="polite"></p>
        </form>
        <div class="admin-login-staff"><p>สำหรับทีม DevCommu</p><a class="admin-secondary admin-link-button" href="/admin/staff">เข้าสู่ระบบด้วยอีเมล @devcommu.org</a></div>
        <p class="admin-help admin-login-help">ยังไม่มีบัญชีหรือลืมรหัสผ่าน? ติดต่อผู้ดูแล DevCommu</p>
        <noscript><p>กรุณาเปิด JavaScript เพื่อเข้าสู่ระบบ</p></noscript>
      </div>
      <a href="/@devcommu/">กลับไปหน้าเว็บไซต์</a>
    </main>
    <script>
      import "../../components/admin/login.ts";
    </script>
  </body>
</html>
