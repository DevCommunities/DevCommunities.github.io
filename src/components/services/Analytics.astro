---
const ga=import.meta.env.PUBLIC_GA_ID || '';
const pixel=import.meta.env.PUBLIC_META_PIXEL_ID || '';
---
{(ga||pixel)&&<aside id="analytics-consent" hidden class="fixed bottom-4 left-4 right-4 z-50 bg-white rounded-2xl shadow-xl p-5 font-lineSansTH max-w-xl border border-slate-200"><p>อนุญาตการวัดผลเว็บไซต์เพื่อช่วยปรับปรุงประสบการณ์การเรียนรู้หรือไม่? <a href="/privacy" class="underline">รายละเอียด</a></p><div class="flex gap-3 mt-3"><button id="analytics-accept" class="bg-primary rounded-full px-5 py-2">ยินยอม</button><button id="analytics-decline" class="bg-slate-200 rounded-full px-5 py-2">ปฏิเสธ</button></div></aside>}
<script is:inline define:vars={{ga,pixel}}>
(()=>{
 if(!ga&&!pixel)return;
 let preference;try{preference=localStorage.getItem('devcommu-analytics')}catch{}
 const banner=document.getElementById('analytics-consent');
 function enable(){
  if(/^G-[A-Z0-9]+$/.test(ga)){
   window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};
   window.gtag('js',new Date());window.gtag('config',ga);
   const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(ga);document.head.appendChild(s);
  }
  if(/^\d+$/.test(pixel)){
   const f=window.fbq=function(){f.callMethod?f.callMethod.apply(f,arguments):f.queue.push(arguments)};f.queue=[];f.loaded=true;f.version='2.0';window._fbq=f;
   f('init',pixel);f('track','PageView');const s=document.createElement('script');s.async=true;s.src='https://connect.facebook.net/en_US/fbevents.js';document.head.appendChild(s);
  }
 }
 if(preference==='accepted')enable();else if(!preference&&banner)banner.hidden=false;
 function choose(value){try{localStorage.setItem('devcommu-analytics',value)}catch{}if(banner)banner.hidden=true;if(value==='accepted')enable()}
 document.getElementById('analytics-accept')?.addEventListener('click',()=>choose('accepted'));
 document.getElementById('analytics-decline')?.addEventListener('click',()=>choose('declined'));
})();
</script>
