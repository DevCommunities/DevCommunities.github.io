---
import { renderEvents } from "../../lib/hub-render";
import { defaultHubContent, type EditableEvent } from "../../lib/hub-content";
interface Props {
  event: EditableEvent;
  today: string;
}
const { event, today } = Astro.props;
---

<Fragment
  set:html={renderEvents([event], defaultHubContent.settings.lineUrl, today)}
/>
