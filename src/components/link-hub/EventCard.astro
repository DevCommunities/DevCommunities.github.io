---
import { lineUrl, type HubEvent } from "../../data/link-hub";
import { imageSize } from "../../lib/image-size";
import { FiArrowUpRight, FiChevronDown } from "react-icons/fi";

interface Props {
  event: HubEvent;
  today: string;
}
const { event, today } = Astro.props;
const closed = event.deadline < today;
const date = new Intl.DateTimeFormat("th-TH", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "Asia/Bangkok",
}).format(new Date(`${event.deadline}T12:00:00+07:00`));
const poster = `/images/link-hub/${event.id}.webp`;
---

<details class="hub-event" data-deadline={event.deadline}>
  <summary>
    <img
      class="hub-thumbnail"
      src={`/images/link-hub/${event.id}-thumb.webp`}
      {...imageSize(`/images/link-hub/${event.id}-thumb.webp`)}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="hub-event-copy">
      <strong>{event.title}</strong>
      {event.schedule && <span>{event.schedule}</span>}
      <span>{event.description}</span>
      <span class="hub-event-price">{event.price}</span>
      <span class="hub-event-deadline"
        >ปิดรับสมัคร <time datetime={event.deadline}>{date}</time></span
      >
      <span class="hub-closed" data-event-closed hidden={!closed}
        >ปิดรับสมัครแล้ว</span
      >
    </span>
    <FiChevronDown className="hub-chevron" aria-hidden="true" />
  </summary>
  <div class="hub-event-body">
    <a
      class="hub-poster"
      href={poster}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`ดูโปสเตอร์ ${event.title} ขนาดเต็ม (เปิดแท็บใหม่)`}
    >
      <img
        src={poster}
        {...imageSize(poster)}
        alt={`โปสเตอร์ ${event.title}`}
        loading="lazy"
        decoding="async"
      />
      <span>ดูโปสเตอร์ขนาดเต็ม <FiArrowUpRight aria-hidden="true" /></span>
    </a>
    {
      event.signupUrl && (
        <a
          class="hub-action hub-action-primary"
          data-event-signup
          hidden={closed}
          href={event.signupUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          สมัครค่ายนี้ <FiArrowUpRight aria-hidden="true" />
        </a>
      )
    }
    {
      event.signupUrl && (
        <a
          class="hub-action"
          href={lineUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          สอบถามรายละเอียดทาง LINE <FiArrowUpRight aria-hidden="true" />
        </a>
      )
    }
  </div>
</details>
